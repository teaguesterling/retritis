# Sample policy for the B conformance skeleton. Workstream B compiles this:
#   umwelt compile sample.umw --target policydb -> .umwelt/policy.db
# then kibitzer (PolicyConsumer.from_db) + lackpy (policy/sources/umwelt) read it,
# and policy_agreement.py asserts both == the umwelt PolicyEngine ground truth.

mode#implement { writable: src/, tests/; }
mode#review    { writable: ; }            /* read-only mode */

tool#Edit { allow: true; }
tool#Read { allow: true; }
tool#Bash { allow: false; }               /* out of policy in implement mode */
